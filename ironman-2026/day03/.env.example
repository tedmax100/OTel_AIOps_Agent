# OTLP endpoint (inside docker-compose network)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# Identity injected at container start. Each service overrides these in its
# own compose entry — these are just safe defaults.
GIT_REPO=tedmax100/o11y-bench-demo
GIT_VERSION=v0.0.0
DEPLOYMENT_ENV=demo

# Feature flag file (optional). If unset, services read flags from env only.
FEATURE_FLAGS_PATH=/etc/demo/flags.json

LOG_LEVEL=INFO
